# NickLabs Orbis build container (Arch Linux, generic x86_64).
# Pin the base by digest for releases: `make container-lock` records it in packaging/container.lock.
ARG BASE=docker.io/archlinux/archlinux:base-devel
FROM ${BASE}
ARG SNAPSHOT=2026/10/20
RUN printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$SNAPSHOT" > /etc/pacman.d/mirrorlist \
 && sed -i 's/^#\[multilib\]/[multilib]/; /^\[multilib\]/{n;s/^#Include/Include/}' /etc/pacman.conf \
 && pacman -Syu --noconfirm --needed git arch-install-scripts devtools python python-numpy \
      clang lld llvm bc flex bison libelf pahole cpio perl \
      meson ninja python-mako python-packaging python-yaml glslang shaderc spirv-headers vulkan-headers \
      cmake xorgproto wayland-protocols cbindgen directx-headers byacc \
      dosfstools mtools e2fsprogs zstd xz \
 && useradd -m builder && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder
WORKDIR /src
