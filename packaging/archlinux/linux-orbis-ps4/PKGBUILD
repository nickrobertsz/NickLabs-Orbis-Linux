# NickLabs Orbis — PS4 kernel (Aeolia/Belize target). Uses kernel/build-kernel.sh so the
# package and a manual build produce the same artifact. The pacman hook
# 95-orbis-kernel-sync stages it on the PS4 boot partition after a loader check.
pkgname=linux-orbis-ps4
_target=aeolia-belize-6.15
pkgver=6.15.4.crashnt4.7
pkgrel=1
pkgdesc="PS4 (Aeolia/Belize) Linux kernel for NickLabs Orbis: feeRnt crashnt-4.7 + Orbis patches, firmware-free"
arch=('x86_64')
url="https://github.com/feeRnt/ps4-linux-12xx"
license=('GPL-2.0-only')
makedepends=('git' 'clang' 'lld' 'llvm' 'bc' 'flex' 'bison' 'libelf' 'perl' 'python' 'pahole' 'cpio')
options=('!strip' '!debug' '!lto')
source=()

# ORBIS_KERNEL_OUT=<dir>: package an existing build-kernel.sh output (bzImage, config,
# modules-<rel>.tar, build-manifest.json, SHA256SUMS) instead of compiling again, e.g. the
# released orbis-kernel-aeolia-belize-6.15-build.tar.gz extracted. Its SHA256SUMS and the
# PS4 loader contract are checked first.
build() {
  local R; R="${startdir}/../../.."
  if [ -n "${ORBIS_KERNEL_OUT:-}" ]; then
    echo "using prebuilt Orbis kernel from $ORBIS_KERNEL_OUT"
    rm -rf "$srcdir/out" && cp -a "$ORBIS_KERNEL_OUT" "$srcdir/out"
    rm -rf "$srcdir/out/modroot"
    ( cd "$srcdir/out" && sha256sum -c SHA256SUMS )
  else
    "$R/kernel/build-kernel.sh" "$_target" --out "$srcdir/out" --src "$srcdir/src"
  fi
  python -I -c "import sys; sys.path.insert(0, sys.argv[1]); from orbis import bzimage; r = bzimage.inspect(sys.argv[2]); print('loader check:', 'ok' if r.ok else r.errors); sys.exit(0 if r.ok and (r.ikconfig or {}).get('CONFIG_X86_PS4') == 'y' else 1)" "$R/platform" "$srcdir/out/bzImage"
}

package() {
  local rel
  rel="$(python -c "import json; print(json.load(open('$srcdir/out/build-manifest.json'))['kernel_release'])")"
  rm -rf "$srcdir/mods" && mkdir -p "$srcdir/mods" "$pkgdir/usr/lib/modules"
  tar -C "$srcdir/mods" -xf "$srcdir/out/modules-$rel.tar"
  # modules_install writes <INSTALL_MOD_PATH>/lib/modules/<rel>; Arch uses /usr/lib.
  mv "$srcdir/mods/lib/modules/$rel" "$pkgdir/usr/lib/modules/$rel"
  rm -f "$pkgdir/usr/lib/modules/$rel"/{build,source}
  install -Dm644 "$srcdir/out/bzImage" "$pkgdir/usr/lib/modules/$rel/vmlinuz"
  install -Dm644 "$srcdir/out/config" "$pkgdir/usr/lib/modules/$rel/config"
  install -Dm644 "$srcdir/out/build-manifest.json" "$pkgdir/usr/lib/modules/$rel/orbis-build-manifest.json"
  echo "$pkgname" > "$pkgdir/usr/lib/modules/$rel/pkgbase"
}
