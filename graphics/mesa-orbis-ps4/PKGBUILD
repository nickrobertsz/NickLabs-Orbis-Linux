# NickLabs Orbis — Mesa for the PS4 Liverpool/Gladius GPU (64-bit).
# Pinned official release + reviewed patch series (graphics/patches/mesa/provenance.json).
# Replaces DionKill's mesa-ps4, which builds from a moving Mesa git HEAD.
pkgname=mesa-orbis-ps4
_mesaver=26.2.5
pkgver=${_mesaver}
pkgrel=1
pkgdesc="Mesa radeonsi + RADV with NickLabs Orbis PS4 patches (Liverpool/Gladius)"
arch=('x86_64')
url="https://www.mesa3d.org"
license=('MIT' 'custom')
depends=('libdrm' 'libxshmfence' 'libelf' 'libglvnd' 'wayland' 'zstd' 'expat' 'llvm-libs'
         'libx11' 'libxext' 'libxfixes' 'libxxf86vm' 'libxcb' 'xcb-util-keysyms' 'libxrandr'
         'vulkan-icd-loader' 'lm_sensors' 'systemd-libs' 'spirv-tools')
makedepends=('meson' 'ninja' 'python-mako' 'python-packaging' 'python-yaml' 'glslang' 'llvm'
             'xorgproto' 'wayland-protocols' 'libxrandr' 'cbindgen' 'directx-headers' 'byacc' 'flex')
provides=("mesa=${_mesaver}" 'opengl-driver' 'vulkan-driver' 'vulkan-radeon' 'mesa-libgl'
          'vulkan-mesa-device-select' 'vulkan-mesa-layers')
conflicts=('mesa' 'vulkan-radeon' 'mesa-libgl' 'vulkan-mesa-device-select' 'vulkan-mesa-layers'
           'mesa-ps4' 'vulkan-swrast')
replaces=('mesa-ps4')
options=('!lto' '!debug')
source=("https://archive.mesa3d.org/mesa-${_mesaver}.tar.xz"
        "0001-ps4-graphics-families.patch"
        "0003-addrlib-selected-fmask-entry.patch"
        "0005-radv-bound-meta-fill-offset.patch"
        "LICENSE.ps4-mesa")
sha256sums=('794b3d1729075dae7ebd47c7283b7ca0cdb5dec668f7f11cc0a5d82f6138a0a5'
            'b3cf0f24fd00f156bbba12be0c270189ad30c274646b5e86298890e4cb4829cc'
            '10f6369f300bd884290cc812254ee3f66694b3d0fdaeee37451b1f93561ba07c'
            '92256289369f880d6c8a85c7bec8341c29da6b7d13706bc4120795e99788ae25'
            'SKIP')

prepare() {
  cd "mesa-${_mesaver}"
  for p in 0001-ps4-graphics-families.patch 0003-addrlib-selected-fmask-entry.patch \
           0005-radv-bound-meta-fill-offset.patch; do
    echo "applying $p"
    patch -Np1 -F0 -i "$srcdir/$p"
  done
}

build() {
  # Jaguar safety: baseline x86-64 code generation, tuned for btver2. Never -march=native/v3.
  export CFLAGS="${CFLAGS/-march=x86-64-v[234]/-march=x86-64} -mtune=btver2"
  export CXXFLAGS="${CXXFLAGS/-march=x86-64-v[234]/-march=x86-64} -mtune=btver2"
  arch-meson "mesa-${_mesaver}" build \
    -D b_ndebug=true \
    -D platforms=x11,wayland \
    -D gallium-drivers=radeonsi,llvmpipe \
    -D vulkan-drivers=amd \
    -D vulkan-layers=device-select \
    -D video-codecs= \
    -D gallium-va=disabled \
    -D gallium-rusticl=false \
    -D llvm=enabled \
    -D shared-llvm=enabled \
    -D glx=dri \
    -D egl=enabled \
    -D gbm=enabled \
    -D gles1=disabled \
    -D gles2=enabled \
    -D glvnd=enabled \
    -D valgrind=disabled \
    -D intel-rt=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "mesa-${_mesaver}/docs/license.rst" "$pkgdir/usr/share/licenses/$pkgname/license.rst"
  install -Dm644 LICENSE.ps4-mesa "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ps4-mesa"
  # Version marker read by orbis-ai-launch / the inference gate.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/orbis/mesa-version" <<<"${_mesaver}-orbis${pkgrel}"
}
